# /etc/familia/mcp.env on the MCP Pi  (NOT committed — real values live only there)
#   sudo install -o familia-mcp -g familia-mcp -m 600 mcp.env.example /etc/familia/mcp.env
#
# Each module is enabled only if its settings are present.

# ---- Prometheus (devices are discovered live from its scrape targets) ----
PROMETHEUS_URL=http://pimonitor.local:9090
# Label that identifies a device. "instance" works out of the box; set another
# label if you add one via relabelling (e.g. a friendly "name" label).
#PROMETHEUS_DEVICE_LABEL=instance
#PROMETHEUS_TIMEOUT_S=5
# Only if your Prometheus sits behind auth:
#PROMETHEUS_BEARER_TOKEN=
#PROMETHEUS_USERNAME=
#PROMETHEUS_PASSWORD=

# ---- Home Assistant (lights and plugs only; see ha_allowlist.example.json) ----
HA_URL=http://homeassistant.local:8123
# Long-lived access token of a DEDICATED non-admin HA user (Profile -> Security).
HA_TOKEN=
#HA_ALLOWLIST_FILE=/etc/familia/ha_allowlist.json
#HA_TIMEOUT_S=5

# ---- Plex (read-only: search, new, continue watching, history, now playing) ----
#PLEX_URL=http://pidata.local:32400
# Server owner token (PlexOnlineToken in the server's Preferences.xml).
#PLEX_TOKEN=
# Per-user server tokens for "continue watching" of Plex Home users:
#PLEX_USER_TOKENS=Kids=<token>;Other=<token>
#PLEX_TIMEOUT_S=8

# ---- Photos (PhotoPrism's built-in read-only MCP endpoint /api/v1/mcp) ----
#PHOTOPRISM_URL=http://photos.local:2342
# App password, scope "mcp read photos albums people labels" (no "places": no coordinates):
#   photoprism auth add -n familia-mcp -s "mcp read photos albums people labels" -e 31536000 <user>
#PHOTOPRISM_TOKEN=
#PHOTOPRISM_TIMEOUT_S=45

# ---- Nextcloud (calendar, tasks, contacts over CalDAV/CardDAV; read + write) ----
#NEXTCLOUD_URL=https://nextcloudpi.local
#NEXTCLOUD_USER=
# Dedicated app password: Nextcloud -> Settings -> Security -> "Create new app password" (name: home-mcp).
#NEXTCLOUD_APP_PASSWORD=
# Self-signed certificate: pin it (install.sh copies deploy/nextcloud.pem here).
#NEXTCLOUD_CERT_FILE=/etc/familia/nextcloud.pem
# Optional: only these calendars / task lists (display names, comma-separated); default all.
#NEXTCLOUD_CALENDARS=Personal,Compra
#NEXTCLOUD_DEFAULT_CALENDAR=Personal
#NEXTCLOUD_DEFAULT_TASKLIST=Personal
# Address book URI new contacts go to (Nextcloud's default is "contacts").
#NEXTCLOUD_ADDRESSBOOK=contacts
# Defaults to the host's time zone.
#NEXTCLOUD_TIMEZONE=Europe/Madrid
#NEXTCLOUD_TIMEOUT_S=10

# Logging goes to stderr -> the proxy's journal on the OVOS Pi.
#FAMILIA_MCP_LOG_LEVEL=INFO
